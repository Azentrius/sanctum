# LF everywhere, whatever the checkout platform; only the Windows wrapper script keeps CRLF.
* text=auto eol=lf
*.bat text eol=crlf

*.jar  binary
*.png  binary
*.webp binary
*.jks  binary
*.woff2 binary

# Not part of a source archive (git archive): repository tooling only.
/.github/       export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
