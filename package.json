    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.28.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "tar": "^7.5.16",
    "minimatch": "^11.0.1",
    "undici": "^7.28.0",
