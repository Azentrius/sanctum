{
  "name": "sanctum",
  "version": "0.9.0",
  "description": "Nextcloud on Android in one app, starting with the calendar and its sync",
  "author": "Stefan Popp",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Azentrius/sanctum",
  "repository": {
    "type": "git",
    "url": "https://github.com/Azentrius/sanctum.git"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:android": "ionic build --prod && npx cap sync android",
    "build:ios": "ionic build --prod && npx cap sync ios",
    "build:all": "ionic build --prod && npx cap sync",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration ci",
    "test:coverage": "ng test --configuration coverage",
    "lint": "ng lint",
    "test:scripts": "vitest run --config vitest-scripts.config.ts",
    "release-notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "@angular/animations": "^21.2.25",
