    "ical.js": "^2.1.0",
    "ionicons": "^8.1.0",
    "luxon": "^3.7.2",
    "pdfjs-dist": "^4.10.38",
    "rxjs": "~7.8.0",
    "tsdav": "^2.5.0",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0",
    "xlsx": "npm:@stackline/xlsx@^1.0.3",
