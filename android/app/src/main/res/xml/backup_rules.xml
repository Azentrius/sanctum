<full-backup-content>
    <!-- Capacitor Preferences (account metadata, legacy keys) -->
    <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    <exclude domain="sharedpref" path="CapacitorStorage" />
    <!-- Ionic Storage SQLite DB -->
    <exclude domain="database" path="ionic_storage" />
    <exclude domain="database" path="ionic_storage.db" />
    <!-- Native sync: credentials under a Keystore key that a restore cannot bring along, and pins -->
    <exclude domain="sharedpref" path="sanctum_sync_credentials.xml" />
    <exclude domain="sharedpref" path="sanctum_cert_pins.xml" />
</full-backup-content>
